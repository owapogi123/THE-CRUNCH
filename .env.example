NODE_ENV=production
PORT=5000

DB_HOST=replace-with-database-host
DB_PORT=3306
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
# Optional for public/external providers that require a trusted custom CA.
# Ignored when DB_HOST ends in .railway.internal.
DB_SSL_CA_PATH=

# One-time fresh-database bootstrap. Set all three only while running
# `npm run db:setup`, then remove INITIAL_ADMIN_PASSWORD from Railway.
INITIAL_ADMIN_USERNAME=System Administrator
INITIAL_ADMIN_EMAIL=replace-with-initial-admin-email
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password

JWT_SECRET=replace-with-long-random-secret
DISCOUNT_AUTH_CODE=replace-with-private-authorization-code

PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=replace-with-paymongo-secret-key
PAYMONGO_PUBLIC_KEY=replace-with-paymongo-public-key
PAYMONGO_SUCCESS_URL=https://replace-with-frontend-host/usersmenu?payment=success
PAYMONGO_CANCEL_URL=https://replace-with-frontend-host/usersmenu?payment=cancelled

EMAIL_PROVIDER=resend
OTP_DELIVERY_MODE=email
EMAIL_FROM=replace-with-verified-sender
RESEND_API_KEY=replace-with-resend-api-key

PRODUCT_CACHE_TTL_SECONDS=30
ORDER_TIMING_ENABLED=false
RAILWAY_VOLUME_MOUNT_PATH=
PROOF_UPLOAD_DIR=
PAYMENT_PROOF_UPLOAD_DIR=
