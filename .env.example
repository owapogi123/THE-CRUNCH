NODE_ENV=production
PORT=5000

DB_HOST=replace-with-database-host
DB_PORT=3306
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
# Optional for public/external providers that require a trusted custom CA.
# Ignored when DB_HOST ends in .railway.internal.
DB_SSL_CA_PATH=

JWT_SECRET=replace-with-long-random-secret
# Optional dedicated HMAC secret for password-reset codes. If omitted, JWT_SECRET is used.
PASSWORD_RESET_TOKEN_SECRET=replace-with-another-long-random-secret
DISCOUNT_AUTH_CODE=replace-with-private-authorization-code

PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=replace-with-paymongo-secret-key
# Hosted Checkout is created entirely by the backend; PAYMONGO_PUBLIC_KEY is not used.
PAYMONGO_SUCCESS_URL=https://thecrunch.site/usersmenu?payment=success
PAYMONGO_CANCEL_URL=https://thecrunch.site/usersmenu?payment=cancelled
# Signing secret shown for the registered /api/paymongo/webhook endpoint.
# This is separate from PAYMONGO_SECRET_KEY.
PAYMONGO_WEBHOOK_SECRET=replace-with-paymongo-webhook-signing-secret
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

EMAIL_PROVIDER=resend
OTP_DELIVERY_MODE=email
EMAIL_FROM=replace-with-verified-sender
RESEND_API_KEY=replace-with-resend-api-key

PRODUCT_CACHE_TTL_SECONDS=30
ORDER_TIMING_ENABLED=false
RAILWAY_VOLUME_MOUNT_PATH=
PROOF_UPLOAD_DIR=
PAYMENT_PROOF_UPLOAD_DIR=
